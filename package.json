{
  "name": "hris-projects",
  "version": "1.0.0",
  "description": "Role-aware HR service request and onboarding platform",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build:postgres": "prisma generate --schema=prisma/postgres/schema.prisma && next build",
    "db:generate": "prisma generate",
    "db:generate:postgres": "prisma generate --schema=prisma/postgres/schema.prisma",
    "db:prepare": "tsx scripts/prepare-db.ts",
    "db:migrate": "npm run db:prepare && prisma migrate dev",
    "db:migrate:postgres": "prisma migrate deploy --schema=prisma/postgres/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "verify:seed": "tsx scripts/verify-seed.ts",
    "verify:seed:postgres": "npm run db:generate:postgres && tsx scripts/verify-seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:setup:postgres": "npm run db:generate:postgres && npm run db:migrate:postgres && npm run db:seed",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "license": "UNLICENSED",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "playwright": "^1.65.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.3",
    "@prisma/client": "^6.19.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.106.1",
    "argon2": "^0.45.2",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "@prisma/client@6.19.0": true,
    "argon2@0.45.2": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "minimatch": "^11.0.1"
  }
}
