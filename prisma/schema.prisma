generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  fullName       String
  employeeNumber String   @unique
  country        String
  department     String
  role           String   @default("EMPLOYEE")
  employmentStatus String @default("ACTIVE")
  joiningDate    DateTime
  managerId      String?
  manager        User?    @relation("Reports", fields: [managerId], references: [id], onDelete: SetNull)
  directReports  User[]   @relation("Reports")
  sessions       AuthSession[]
  requests       ServiceRequest[] @relation("Requester")
  assignments    ServiceRequest[] @relation("Assignee")
  comments       RequestComment[]
  statusChanges  RequestStatusHistory[]
  onboardings    Onboarding[] @relation("NewHire")
  createdOnboardings Onboarding[] @relation("OnboardingCreator")
  ownedTasks     OnboardingTask[]
  taskChanges    OnboardingTaskHistory[]
  createdTemplates OnboardingTemplate[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([managerId])
  @@index([country, department, role, employmentStatus])
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model ServiceRequest {
  id          String   @id @default(cuid())
  requestNumber String @unique
  title       String
  description String
  category    String
  priority    String
  status      String   @default("SUBMITTED")
  requesterId String
  requester   User     @relation("Requester", fields: [requesterId], references: [id])
  assigneeId  String?
  assignee    User?    @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments    RequestComment[]
  history     RequestStatusHistory[]
  resolvedAt DateTime?
  closedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([requesterId, status])
  @@index([assigneeId, status])
  @@index([category, priority, status])
}

model RequestComment {
  id        String   @id @default(cuid())
  requestId String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@index([requestId, createdAt])
}

model RequestStatusHistory {
  id         String   @id @default(cuid())
  requestId  String
  actorId    String
  fromStatus String?
  toStatus   String
  note       String?
  createdAt  DateTime @default(now())
  request    ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor      User     @relation(fields: [actorId], references: [id])

  @@index([requestId, createdAt])
}

model OnboardingTemplate {
  id          String   @id @default(cuid())
  name        String
  description String
  version     Int      @default(1)
  active      Boolean  @default(true)
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  tasks       TemplateTask[]
  instances   Onboarding[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TemplateTask {
  id             String   @id @default(cuid())
  templateId     String
  title          String
  description    String
  department     String
  ownerRole      String
  dueOffsetDays  Int
  sortOrder      Int
  dependsOnId    String?
  template       OnboardingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  dependsOn      TemplateTask? @relation("TemplateDependency", fields: [dependsOnId], references: [id], onDelete: SetNull)
  dependents     TemplateTask[] @relation("TemplateDependency")
  instanceTasks  OnboardingTask[]

  @@unique([templateId, sortOrder])
  @@index([templateId])
}

model Onboarding {
  id          String   @id @default(cuid())
  employeeId  String
  templateId  String
  createdById String
  startDate   DateTime
  status      String   @default("IN_PROGRESS")
  employee    User     @relation("NewHire", fields: [employeeId], references: [id])
  template    OnboardingTemplate @relation(fields: [templateId], references: [id])
  createdBy   User     @relation("OnboardingCreator", fields: [createdById], references: [id])
  tasks       OnboardingTask[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId, status])
}

model OnboardingTask {
  id             String   @id @default(cuid())
  onboardingId   String
  templateTaskId String
  ownerId        String?
  title          String
  description    String
  department     String
  dueOffsetDays  Int
  dueDate        DateTime
  status         String   @default("NOT_STARTED")
  dependsOnId    String?
  completedAt    DateTime?
  onboarding     Onboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  sourceTask     TemplateTask @relation(fields: [templateTaskId], references: [id])
  owner          User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  dependsOn      OnboardingTask? @relation("TaskDependency", fields: [dependsOnId], references: [id], onDelete: SetNull)
  dependents     OnboardingTask[] @relation("TaskDependency")
  history        OnboardingTaskHistory[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([onboardingId, templateTaskId])
  @@index([ownerId, status])
  @@index([onboardingId, dueDate, status])
}

model OnboardingTaskHistory {
  id         String   @id @default(cuid())
  taskId     String
  actorId    String
  fromStatus String
  toStatus   String
  note       String?
  createdAt  DateTime @default(now())
  task       OnboardingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor      User     @relation(fields: [actorId], references: [id])

  @@index([taskId, createdAt])
}
