DATABASE_URL="file:./dev.db"
DIRECT_URL=""
# Required server-side key for translating natural-language questions into SQL.
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# For PostgreSQL, set DATABASE_URL to the Supabase transaction pooler URL
# (port 6543, with pgbouncer=true) and DIRECT_URL to the direct or session
# pooler URL for migrations. Keep real credentials in .env, never here.
